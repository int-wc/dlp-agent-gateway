# Copy to .env and replace EVERY example key with distinct random values.
# e.g. python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DLP_ADMIN_KEY=replace-with-a-random-admin-secret
DLP_CLIENT_KEYS_JSON={"demo-user":"replace-with-a-different-random-client-secret"}
# Used by Docker Compose PostgreSQL. Generate another distinct random value.
DLP_DB_PASSWORD=replace-with-a-random-database-password
# Local binary fallback only. Docker Compose uses PostgreSQL.
DLP_DB_PATH=./var/audit.json
# DLP_LISTEN_ADDRESS=127.0.0.1:18080
# Optional Python parser worker for PDF/DOCX/image extraction.
# Leave this unset for Go rules-only mode; supported UTF-8 text files still work.
# DLP_ANALYZER_URL=http://127.0.0.1:19090
# Optional. A configured destination is the ONLY permitted forwarding target.
# Secrets are read indirectly from credential_env and never stored in this JSON.
# DLP_DESTINATIONS_JSON={"business-upload":{"kind":"internal","url":"https://business.example/upload","credential_env":"BUSINESS_UPLOAD_TOKEN","upload_field":"file"}}
# BUSINESS_UPLOAD_TOKEN=replace-with-upstream-service-token
# Optional upstream mTLS fields: ca_file, client_cert_file, client_key_file.
#
# Optional enterprise browser login. Redirect must be registered at the provider.
# DLP_OIDC_ISSUER_URL=https://identity.example/realms/security
# DLP_OIDC_CLIENT_ID=dlp-console
# DLP_OIDC_CLIENT_SECRET=replace-with-oidc-client-secret
# DLP_OIDC_REDIRECT_URL=https://gateway.example/auth/callback
# DLP_SESSION_SECRET=replace-with-at-least-32-random-characters
# DLP_OIDC_ROLE_CLAIM=roles
# DLP_OIDC_ADMIN_ROLE=dlp-admin
# DLP_OIDC_OPERATOR_ROLE=dlp-operator
# DLP_OIDC_VIEWER_ROLE=dlp-viewer
# DLP_COOKIE_SECURE=true
#
# Optional workload mTLS identity mapping. Configure gateway TLS and a trusted client CA.
# DLP_TLS_CERT_FILE=/run/secrets/gateway.crt
# DLP_TLS_KEY_FILE=/run/secrets/gateway.key
# DLP_CLIENT_CA_FILE=/run/secrets/client-ca.crt
# DLP_MTLS_ACTORS_JSON={"uri:spiffe://example/workload/uploader":"business-uploader"}
# DLP_REQUIRE_MTLS=true
# Optional, local Ollama only. No document content is sent to any hosted model.
# DLP_OLLAMA_MODEL=qwen2.5:7b
# DLP_OLLAMA_URL=http://127.0.0.1:11434/api/generate
